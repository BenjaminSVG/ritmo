<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoy"
            android:textColor="#1B1B1F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4F6AF5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_add_button"
            android:contentDescription="Nueva tarea"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_line1"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_line2"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_line3"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_line4"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_line5"
        style="@style/WidgetLine" />
</LinearLayout>
